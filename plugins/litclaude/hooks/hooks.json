{
  "modules": ["./lit-mod.mjs"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" session-start",
            "timeout": 60,
            "statusMessage": "checking LitClaude update and rules"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" user-prompt-submit",
            "timeout": 10,
            "statusMessage": "checking LitClaude workflow and bounded-authority lifecycle"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|Bash|Agent|Skill)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" pre-tool-use",
            "timeout": 10,
            "statusMessage": "checking LitClaude bounded authority"
          }
        ]
      },
      {
        "matcher": "^(WebFetch|WebSearch|CronCreate|CronDelete|ScheduleWakeup|SendMessage|EnterWorktree|Workflow|RemoteTrigger|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" check-back-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" post-tool-use",
            "timeout": 30,
            "statusMessage": "running LitClaude post-edit checks"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" post-tool-use-failure",
            "timeout": 10,
            "statusMessage": "moving the LIT card's workflow map"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" pre-compact",
            "timeout": 30,
            "statusMessage": "saving a LitClaude handoff before compaction"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "^(permission_prompt|idle_prompt|agent_needs_input)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" notification",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" stop",
            "timeout": 10,
            "statusMessage": "checking LitClaude start-work and litgoal completion"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" subagent-start",
            "timeout": 10,
            "statusMessage": "registering LitClaude start-work lane"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" subagent-stop",
            "timeout": 10,
            "statusMessage": "finalizing LitClaude start-work lane"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/litclaude-hook.js\" session-end",
            "timeout": 10,
            "statusMessage": "recording LitClaude session end"
          }
        ]
      }
    ]
  }
}
